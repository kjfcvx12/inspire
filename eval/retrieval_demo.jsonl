# 데모 코퍼스(data/demo_faq) 검색 적중률 케이스. 재현: python scripts/eval_retrieval.py eval/retrieval_demo.jsonl --docs data/demo_faq
# 키워드가 겹치는 질문
{"q": "환불은 며칠 안에 신청해야 하나요?", "expect_source": "refund.md"}
{"q": "제주도 배송비는 얼마인가요?", "expect_source": "shipping.md"}
{"q": "포인트 유효기간이 어떻게 되나요?", "expect_source": "points.md"}
{"q": "무통장입금은 언제까지 해야 하나요?", "expect_source": "payment.md"}
{"q": "고객센터 점심시간 알려주세요", "expect_source": "support.md"}
# 표현이 다른 질문(동의어·우회 표현)
{"q": "산 물건 돈 돌려받고 싶어요", "expect_source": "refund.md"}
{"q": "탈퇴하면 적립금은 어떻게 되나요?", "expect_source": "withdraw.md"}
{"q": "패스워드를 잊어버렸어요", "expect_source": "password.md"}
{"q": "옷이 안 맞아서 바꾸고 싶어요", "expect_source": "exchange.md"}
{"q": "주말에도 상담 받을 수 있나요?", "expect_source": "support.md"}
{"q": "택배는 언제쯤 오나요?", "expect_source": "shipping.md"}
# 문서에 없는 질문(근거 없음이어야 정상)
{"q": "화성 이주 신청 방법", "expect_none": true}
{"q": "오늘 서울 날씨 어때요", "expect_none": true}
