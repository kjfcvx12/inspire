{
  "env": {
    "PYTHONUTF8": "1"
  },
  "permissions": {
    "allow": [
      "Bash(uv:*)",
      "Bash(python:*)",
      "Bash(pip:*)",
      "Bash(conda:*)",
      "Bash(pytest:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(streamlit:*)",
      "Bash(uvicorn:*)",
      "WebSearch",
      "WebFetch",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "mcp__context7",
      "mcp__playwright"
    ],
    "deny": [
      "Read(.env)",
      "Read(**/.env)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Read|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "python -X utf8 \"$CLAUDE_PROJECT_DIR/.claude/hooks/block_env_read.py\"",
            "shell": "bash",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "enabledMcpjsonServers": ["playwright", "context7"]
}
